# Copy to .env.local for local development; set the same variables in Vercel → Settings → Environment Variables.

# Public URL of the app (metadata, absolute links). Production: https://timecraft.pro
NEXT_PUBLIC_SITE_URL=https://timecraft.pro

# --- Supabase Auth (team sign-in with email + password) ---
# TimeCraft needs its own Supabase project: Dashboard → Project Settings → API.
# Without these two the app has no way to sign anyone in and /login says so.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only admin key (never expose with a NEXT_PUBLIC_ prefix).
# Optional: needed only to create or invite users from backend code / scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Agent tokens for GET /api/context — one per agent in agents/access.json, named AGENT_TOKEN_<ID>.
# These are independent of user sign-in. Leave empty to disable that agent's API access.
AGENT_TOKEN_CLAUDE=
AGENT_TOKEN_GEMINI=
