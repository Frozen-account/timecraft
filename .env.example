# Copy to .env.local for local development; set the same variables in Vercel → Settings → Environment Variables.

# Public URL of the app (metadata, absolute links). Production: https://timecraft.pro
NEXT_PUBLIC_SITE_URL=https://timecraft.pro

# Team access key for the /login page. Required: without it nobody can sign in.
# Changing it signs everyone out. Generate one: openssl rand -base64 32
TIMECRAFT_ACCESS_KEY=

# Agent tokens for GET /api/context — one per agent in agents/access.json, named AGENT_TOKEN_<ID>.
# Leave empty to disable that agent's API access.
AGENT_TOKEN_CLAUDE=
AGENT_TOKEN_GEMINI=
